# Admin Panel Security & Authentication
# Restrict admin access strictly to your personal email
ADMIN_EMAIL=sushandjain@gmail.com

# Initial default admin password (used on first initialization if database not yet seeded)
# Change this immediately after first login or set a strong custom password here!
ADMIN_PASSWORD=SushanAdmin@2026!

# Cryptographic secret for signing HTTP-only session JWT cookies (min 32 characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=super_secret_portfolio_jwt_key_sushan_jain_2026_secure_key

# Session duration in seconds (86400 = 24 hours, 7200 = 2 hours)
SESSION_MAX_AGE=86400

# Base URL of your site (used for metadata, open graph, and password reset links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
